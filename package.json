{
  "name": "private-public-ssh-relay-source",
  "version": "5.6.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/near.cjs src/remote.cjs --bundle --platform=node --target=node22 --outdir=dist --out-extension:.js=.cjs --legal-comments=external --external:cpu-features --external:./crypto/build/Release/sshcrypto.node",
    "start": "electron .",
    "near": "node src/pro/cli.cjs start --role near",
    "permissions": "node src/permissions.cjs",
    "mcp": "node src/mcp.cjs",
    "pro:agent": "node src/pro/cli.cjs start",
    "pro:ui": "electron ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@serenity-kit/opaque": "1.1.0",
    "https-proxy-agent": "^7.0.6",
    "mqtt": "5.16.1",
    "ssh2": "1.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "desktop/main.cjs"
}
